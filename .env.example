# Daily Tech News configuration
# Copy this file to `.env` and fill in your own values.
# The `.env` file is gitignored and must never be committed.

# Telegram Bot API token from @BotFather (e.g. 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# The chat ID the bot should send messages to.
# For a personal chat this is a numeric ID; for a channel it may be like -1001234567890.
TELEGRAM_CHAT_ID=

# Optional: override the default news feed URL (Hacker News front page).
# You can also pass this per-run with `--feed-url`.
# NEWS_FEED_URL=https://hnrss.org/frontpage
